# ── Telegram ──────────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── AI Provider (OpenAI, DeepSeek, OpenRouter, etc.) ───────────────────────
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o
# For DeepSeek API:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com

# ── Database ──────────────────────────────────────────────────────────────────
# Used by the app (asyncpg driver). Docker Compose sets this automatically.
DATABASE_URL=postgresql+asyncpg://assistant:changeme@db:5432/assistant
POSTGRES_PASSWORD=changeme

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
# Application type: Web application
# Authorized redirect URI: https://yourdomain.com/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback

# ── App ───────────────────────────────────────────────────────────────────────
# Random secret for signing OAuth state. Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_secret_key_here
BASE_URL=https://yourdomain.com
LOG_LEVEL=INFO
